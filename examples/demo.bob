<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Phoebus TUI Demo - $(SYS)</name>
  <width>800</width>
  <height>480</height>
  <macros>
    <SYS>DEMO</SYS>
  </macros>
  <background_color>
    <color name="Background" red="240" green="240" blue="240"/>
  </background_color>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>$(SYS) Engineering Screen</text>
    <width>800</width>
    <height>40</height>
    <font>
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0"/>
    </font>
    <foreground_color>
      <color name="White" red="255" green="255" blue="255"/>
    </foreground_color>
    <background_color>
      <color name="Header_Background" red="77" green="77" blue="77"/>
    </background_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="group" version="2.0.0">
    <name>Readbacks</name>
    <x>10</x>
    <y>50</y>
    <width>380</width>
    <height>230</height>
    <transparent>true</transparent>
    <widget type="label" version="2.0.0">
      <name>SineLabel</name>
      <text>Sine</text>
      <x>10</x>
      <y>10</y>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Sine</name>
      <pv_name>sim://sine(-10, 10, 40, 0.1)</pv_name>
      <x>120</x>
      <y>10</y>
      <width>120</width>
      <precision>3</precision>
    </widget>
    <widget type="label" version="2.0.0">
      <name>NoiseLabel</name>
      <text>Noise</text>
      <x>10</x>
      <y>40</y>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Noise</name>
      <pv_name>sim://noise(0, 100, 0.5)</pv_name>
      <x>120</x>
      <y>40</y>
      <width>120</width>
      <format>2</format>
      <precision>2</precision>
    </widget>
    <widget type="label" version="2.0.0">
      <name>RampLabel</name>
      <text>Ramp</text>
      <x>10</x>
      <y>70</y>
    </widget>
    <widget type="progressbar" version="2.0.0">
      <name>Ramp</name>
      <pv_name>sim://ramp(0, 100, 1, 0.1)</pv_name>
      <x>120</x>
      <y>70</y>
      <width>240</width>
    </widget>
    <widget type="label" version="2.0.0">
      <name>HeartbeatLabel</name>
      <text>Heartbeat</text>
      <x>10</x>
      <y>100</y>
    </widget>
    <widget type="led" version="2.0.0">
      <name>Heartbeat</name>
      <pv_name>sim://flipflop(1)</pv_name>
      <x>120</x>
      <y>100</y>
    </widget>
    <widget type="label" version="2.0.0">
      <name>ModeRBVLabel</name>
      <text>Mode</text>
      <x>10</x>
      <y>130</y>
    </widget>
    <widget type="multi_state_led" version="2.0.0">
      <name>ModeRBV</name>
      <pv_name>loc://$(SYS):mode</pv_name>
      <x>120</x>
      <y>130</y>
      <width>120</width>
      <states>
        <state>
          <value>0</value>
          <label>Idle</label>
          <color>
            <color name="Off" red="60" green="100" blue="60"/>
          </color>
        </state>
        <state>
          <value>1</value>
          <label>Running</label>
          <color>
            <color name="On" red="0" green="255" blue="0"/>
          </color>
        </state>
        <state>
          <value>2</value>
          <label>Fault</label>
          <color>
            <color name="MAJOR" red="255" green="0" blue="0"/>
          </color>
        </state>
      </states>
    </widget>
    <widget type="label" version="2.0.0">
      <name>BitsLabel</name>
      <text>Bits</text>
      <x>10</x>
      <y>160</y>
    </widget>
    <widget type="byte_monitor" version="2.0.0">
      <name>Bits</name>
      <pv_name>sim://ramp(0, 255, 1, 0.2)</pv_name>
      <x>120</x>
      <y>160</y>
      <width>160</width>
      <numBits>8</numBits>
    </widget>
  </widget>
  <widget type="group" version="2.0.0">
    <name>Controls</name>
    <x>410</x>
    <y>50</y>
    <width>380</width>
    <height>230</height>
    <transparent>true</transparent>
    <widget type="label" version="2.0.0">
      <name>SetpointLabel</name>
      <text>Setpoint</text>
      <x>10</x>
      <y>10</y>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>Setpoint</name>
      <pv_name>loc://$(SYS):setpoint(5.0)</pv_name>
      <x>120</x>
      <y>10</y>
      <precision>2</precision>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>SetpointRBV</name>
      <pv_name>loc://$(SYS):setpoint</pv_name>
      <x>230</x>
      <y>10</y>
      <precision>2</precision>
    </widget>
    <widget type="label" version="2.0.0">
      <name>EnableLabel</name>
      <text>Enable</text>
      <x>10</x>
      <y>40</y>
    </widget>
    <widget type="bool_button" version="2.0.0">
      <name>Enable</name>
      <pv_name>loc://$(SYS):enable(0)</pv_name>
      <x>120</x>
      <y>40</y>
      <width>140</width>
      <height>20</height>
      <on_label>Enabled</on_label>
      <off_label>Disabled</off_label>
    </widget>
    <widget type="label" version="2.0.0">
      <name>ModeLabel</name>
      <text>Mode</text>
      <x>10</x>
      <y>70</y>
    </widget>
    <widget type="combo" version="2.0.0">
      <name>Mode</name>
      <pv_name>loc://$(SYS):mode&lt;VEnum&gt;(0, "Idle", "Running", "Fault")</pv_name>
      <x>120</x>
      <y>70</y>
      <width>160</width>
      <height>20</height>
    </widget>
    <widget type="checkbox" version="2.0.0">
      <name>EnableCheck</name>
      <pv_name>loc://$(SYS):enable</pv_name>
      <label>Enabled (checkbox)</label>
      <x>10</x>
      <y>100</y>
      <width>250</width>
    </widget>
    <widget type="label" version="2.0.0">
      <name>SliderLabel</name>
      <text>Slider</text>
      <x>10</x>
      <y>130</y>
    </widget>
    <widget type="scaledslider" version="2.0.0">
      <name>Slider</name>
      <pv_name>loc://$(SYS):setpoint</pv_name>
      <x>120</x>
      <y>130</y>
      <width>240</width>
      <height>40</height>
      <limits_from_pv>false</limits_from_pv>
      <minimum>0</minimum>
      <maximum>10</maximum>
      <increment>0.5</increment>
    </widget>
  </widget>
  <widget type="polyline" version="2.0.0">
    <name>Separator</name>
    <x>10</x>
    <y>285</y>
    <width>780</width>
    <height>10</height>
    <points>
      <point x="0.0" y="5.0"/>
      <point x="780.0" y="5.0"/>
    </points>
    <line_width>1</line_width>
    <line_color>
      <color name="Grid" red="128" green="128" blue="128"/>
    </line_color>
  </widget>
  <widget type="tank" version="2.0.0">
    <name>Level</name>
    <pv_name>sim://sine(0, 100, 40, 0.1)</pv_name>
    <x>10</x>
    <y>300</y>
    <width>60</width>
    <height>160</height>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Reset</name>
    <actions>
      <action type="write_pv">
        <pv_name>loc://$(SYS):setpoint</pv_name>
        <value>0</value>
        <description>Reset Setpoint</description>
      </action>
    </actions>
    <x>100</x>
    <y>300</y>
    <width>160</width>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Start</name>
    <actions>
      <action type="write_pv">
        <pv_name>loc://$(SYS):mode</pv_name>
        <value>1</value>
        <description>Start</description>
      </action>
    </actions>
    <x>100</x>
    <y>340</y>
    <width>160</width>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>OpenDetail</name>
    <actions>
      <action type="open_display">
        <file>detail.bob</file>
        <macros>
          <DEV>Motor1</DEV>
        </macros>
        <target>tab</target>
        <description>Open Motor1 Detail</description>
      </action>
    </actions>
    <x>100</x>
    <y>380</y>
    <width>160</width>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>More</name>
    <text>More...</text>
    <actions>
      <action type="open_display">
        <file>detail.bob</file>
        <macros>
          <DEV>Motor2</DEV>
        </macros>
        <target>tab</target>
        <description>Open Motor2 Detail</description>
      </action>
      <action type="write_pv">
        <pv_name>loc://$(SYS):mode</pv_name>
        <value>2</value>
        <description>Trigger Fault</description>
      </action>
    </actions>
    <x>100</x>
    <y>420</y>
    <width>160</width>
  </widget>
  <widget type="embedded" version="2.0.0">
    <name>EmbeddedDetail</name>
    <file>detail.bob</file>
    <macros>
      <DEV>Embedded</DEV>
    </macros>
    <x>410</x>
    <y>300</y>
    <width>380</width>
    <height>160</height>
  </widget>
</display>
